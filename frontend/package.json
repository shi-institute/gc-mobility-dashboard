{
  "name": "gc-mobility-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gispreview": "NODE_ENV=development npm run build && npm run zipdist",
    "data": "node beforeStart.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "zipdist": "tar --create --use-compress-program=pigz --file dist.tar.gz dist && rm -rf dist && mkdir dist && mv dist.tar.gz dist/",
    "zipdata": "tar --create --use-compress-program=pigz --file data.tar.gz public",
    "preinstall": "npm run install-cotar-core",
    "format": "prettier --write .",
    "install-cotar-core": "./install-cotar-core.sh"
  },
  "dependencies": {
    "@arcgis/map-components": "^5.1.27",
    "@chunkd/source-http": "^11.4.2",
    "@cotar/core": "file:@cotar/core@6.0.1+50eff77.tgz",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@observablehq/plot": "^0.6.19",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^26.6.6",
    "dompurify": "^3.4.18",
    "groupby-polyfill": "^1.0.0",
    "htl": "^1.0.0",
    "marked": "^18.2.1",
    "object-path": "^0.11.8",
    "pako": "^3.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.2.0",
    "@types/object-path": "^0.11.4",
    "@types/pako": "^3.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-dom": "^5.30.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-react-x": "^5.30.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
